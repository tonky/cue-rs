-- in.cue --
a: div(7, 3) @test(eq, 2)
b: div(-7, 3) @test(eq, -3)
c: div(7, -3) @test(eq, -2)
d: div(-7, -3) @test(eq, 3)
e: mod(-7, 3) @test(eq, 2)
f: mod(7, -3) @test(eq, 1)
g: mod(-7, -3) @test(eq, 2)
h: quo(-7, 3) @test(eq, -2)
i: rem(-7, 3) @test(eq, -1)
j: rem(7, -3) @test(eq, 1)
k: 1.5K @test(eq, 1500)
l: 1.5Ki @test(eq, 1536)
n: 1.0T @test(kind=int)
