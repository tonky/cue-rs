-- in.cue --
choice: *{3, #x:1} | {3, #x:2}
selected: choice & {_, #x:2}
field: selected.#x @test(eq, 2)
value: selected+0 @test(eq, 3)
#Calc: {#x+1, #x:*1|int}
nested: {value: #Calc} & {value: {_, #x:5} & 6}
nestedValue: nested.value+0 @test(eq, 6)
recipeChoice: *#Calc | {7, #x:6}
recipeSelected: recipeChoice & {_, #x:6}
recipeValue: recipeSelected+0 @test(eq, 7)
