-- in.cue --
#Task: {name?: string, command: string}
#C: {
	worker?: string
	lint?:   string | #Task
	test?:   string | #Task
}
#P: components?: [string]: #C

_onMac: {worker: "mac", ...}
_tmpl: {
	_onMac
	#package: string
	lint: {name: "clippy", command: "cargo clippy -p \(#package)"}
	test: "cargo test -p \(#package)"
	...
}
pipeline: #P & {components: x: _tmpl & {#package: "x"}}

_t: {p: string, l: "c \(p)"}
meetsString: {l: string} & _t & {p: "x"}
optional: {l?: string} & _t & {p: "x"}
top: {l?: _} & _t & {p: "x"}
split: {l: string}
split: {l: "c \(p)", p: string}
split: p: "x"
_n: {n: >1024, l: "port \(n)"}
bound: {l: =~"^port"} & _n & {n: 8080}
_label: {_onMac, k: string, "\(k)-job": {cmd: "run \(k)"}}
label: {worker?: string, ...} & _label & {k: "a"}
_guard: {_onMac, p: string, if "\(p)" == "a" {z: "is \(p)"}}
guard: {z?: string, ...} & _guard & {p: "a"}
_elem: {_onMac, p: string, args: ["-p", "\(p)"]}
elem: {args?: [...string], ...} & _elem & {p: "a"}
