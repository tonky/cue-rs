-- in.cue --
#D: {*(#x+1) | {f:#x} | {g:#x}, #x:*1|int, flag?:bool}
a: #D & {f:3,#x:3,flag:true}
af: a.f @test(eq,3)
b: {g:4,#x:4} & #D
bg: b.g @test(eq,4)
bad: #D & {f:3,g:3,#x:3} @test(err,code=eval)
extra: #D & {f:3,z:4,#x:3} @test(err,code=eval)
wrong: #D & {f:2,#x:3} @test(err,code=eval)
s: (#D & {_,#x:5}) & 6 @test(eq,6)
base: #D+0 @test(eq,2)
#Nested: {*(#x+1) | {f:{n:#x}}, #x:*1|int}
n: #Nested & {f:{n:3},#x:3}
nv: n.f.n @test(eq,3)
badNested: #Nested & {f:{n:3,z:1},#x:3} @test(err,code=eval)
#Open: {*(#x+1) | {f:#x,...}, #x:*1|int}
o: #Open & {f:3,z:4,#x:3}
ov: o.z @test(eq,4)
