Test list.Concat and list.Repeat
-- in.cue --
package test

import "list"

l1: list.Concat([[1, 2], [3, 4], [5]])
l2: list.Repeat("abc", 4)
l3: list.Repeat(0, 5)

-- out/eval --
l1: [
    1,
    2,
    3,
    4,
    5
]
l2: [
    "abc",
    "abc",
    "abc",
    "abc"
]
l3: [
    0,
    0,
    0,
    0,
    0
]
