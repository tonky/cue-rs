            ports: [
                80,
                443
            ]
        }
    }
    "us-east": {
        auth: {
            cluster: "us-east-auth"
            ports: [
                80,
                443
            ]
        }
        billing: {
            cluster: "us-east-billing"
            ports: [
                80,
                443
            ]
        }
    }
}
