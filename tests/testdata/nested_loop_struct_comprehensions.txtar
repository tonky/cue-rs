Test complex nested loop struct comprehensions
-- in.cue --
package test

regions: ["us-east", "eu-west"]
services: ["auth", "billing"]

grid: {
    for r in regions {
        (r): {
            for s in services {
                (s): {
                    cluster: "\(r)-\(s)"
                    ports:   [80, 443]
                }
            }
        }
    }
}

-- out/eval --
