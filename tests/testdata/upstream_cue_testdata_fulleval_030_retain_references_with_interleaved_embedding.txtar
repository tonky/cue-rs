#name: retain references with interleaved embedding
#evalFull
-- in.cue --
a: d: {
	#base
	#info: {...}
	Y:     #info.X
} @test(eq, {
	#info: {X: "foo"}
	Y: "foo"
}) @test(closed)

#base: {
	#info: {...} @test(closed)
} @test(eq, { #info: {} })

a: [string]~(Name,_): {
	#info: {
		X: "foo"
	}
}
