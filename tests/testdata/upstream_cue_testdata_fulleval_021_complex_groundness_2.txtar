#name: complex groundness  2
#evalFull
-- in.cue --
r1: f1 & {y: "c"} @test(eq, {
	y: "c"
	res: {d: "c", s: "ac"}
})

f1: {y: string, res: a.b.c & {d: y}} @test(eq, {
	y: string
	res: {
		d: string
		s: _|_ @test(err, code=incomplete,
			pos=[9:38, 0:34, 9:27, 14:27, 15:13])
	}
})

a: b: c:              {d: string, s: "a" + d} @test(eq, {
	d: string
	s: _|_ @test(err, code=incomplete,
		pos=[0:38, 0:27, 5:27, 6:13])
})
a: b: [string]~(C,_): {d: string, s: "a" + d}
a: b: c: d: string
