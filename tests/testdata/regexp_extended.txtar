Test extended regexp package functions (Find, FindAll, ReplaceAll)
-- in.cue --
package test

text: "The year is 2026, version 2.0.4"

firstNum: regexp.Find("[0-9]+", text)
allNums:  regexp.FindAll("[0-9]+", text, -1)
twoNums:  regexp.FindAll("[0-9]+", text, 2)
censored: regexp.ReplaceAll("[0-9]+", text, "XXX")

-- out/eval --
allNums: [
    "2026",
    "2",
    "0",
    "4"
]
censored: "The year is XXX, version XXX.XXX.XXX"
firstNum: "2026"
text: "The year is 2026, version 2.0.4"
twoNums: [
    "2026",
    "2"
]
